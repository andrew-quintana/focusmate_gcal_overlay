{
  "manifest_version": 3,
  "name": "FocusMate GCal Overlay",
  "version": "1.0.0",
  "description": "A Chrome extension for managing FocusMate calendar",
  "permissions": [
    "storage",
    "identity",
    "scripting"
  ],
  "host_permissions": [
    "https://app.focusmate.com/*",
    "https://api.focusmate.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.focusmate.com/*"
      ],
      "js": ["dist/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "oauth2": {
    "client_id": "1057083449338-9vn0ac4bjibb3d0566vfv4fh59krv915.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}

